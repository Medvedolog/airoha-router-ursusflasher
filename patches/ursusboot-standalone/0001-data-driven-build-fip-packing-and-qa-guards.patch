diff --git a/build.sh b/build.sh
index 0c6576bb..e46e95ae 100755
--- a/build.sh
+++ b/build.sh
@@ -1,15 +1,87 @@
 #!/usr/bin/env bash
+# Build UrsusBoot for one board profile and, when a FIP is available, emit a
+# ready-to-flash 512 KiB mtd0 install image.
+#
+#   OPENWRT_SDK=/path/to/sdk ./build.sh [board] [runtime-role] [sdk]
+#
+# Board and runtime role come from config/board-profiles.json; nothing about a
+# board is hardcoded here.
 set -euo pipefail
-ROOT="$(cd "$(dirname "$0")" && pwd)"; BOARD="${1:-xg040-md}"; ROLE="${2:-persistent}"; SDK="${OPENWRT_SDK:-${3:-}}"
-case "$BOARD" in
-  xg040-md) TEMPLATE="$ROOT/boards/nokia-xg040-md/stock-mtd0-template.bin"; CONFIG="$ROOT/config/u-boot.TEST61.full.config" ;;
-  xg040-mf) TEMPLATE="$ROOT/boards/nokia-xg040-mf/stock-mtd0-template.bin"; CONFIG="$ROOT/config/an7583_nokia_xg-040g-mf_MF2_RAM_defconfig" ;;
-  *) echo "usage: OPENWRT_SDK=/path/to/sdk ./build.sh {xg040-md|xg040-mf} [persistent|ram-recovery]" >&2; exit 2 ;;
-esac
+
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+REGISTRY="$ROOT/config/board-profiles.json"
+RESOLVE="$ROOT/scripts/resolve_board_profile.py"
+BOARD="${1:-xg040-md}"
+ROLE="${2:-}"
+SDK="${OPENWRT_SDK:-${3:-}}"
+
+role_args=()
+[ -n "$ROLE" ] && role_args=(--role "$ROLE")
+
+profile_field() {
+    python3 "$RESOLVE" --registry "$REGISTRY" --profile "$BOARD" \
+        ${role_args[@]+"${role_args[@]}"} --field "$1"
+}
+
+# Resolving the role also validates it against the profile's allowed_roles.
+ROLE="$(profile_field runtime_role)"
+CONFIG="$ROOT/config/$(profile_field config)"
+TEMPLATE="$ROOT/$(profile_field boot_area_template)"
+[ -f "$CONFIG" ] || { echo "board $BOARD: missing config $CONFIG" >&2; exit 3; }
+[ -f "$TEMPLATE" ] || { echo "board $BOARD: missing boot-area template $TEMPLATE" >&2; exit 3; }
+
 : "${SDK:?Set OPENWRT_SDK to an extracted OpenWrt SDK/toolchain}"
 export STAGING_DIR="$SDK/staging_dir"
-CROSS="$(find "$STAGING_DIR" -type f \( -name 'aarch64-openwrt-linux-musl-gcc' -o -name 'aarch64-openwrt-linux-gcc' \) | head -1 || true)"; [ -n "$CROSS" ] || { echo 'AArch64 compiler not found in OpenWrt SDK' >&2; exit 3; }; export CROSS_COMPILE="${CROSS%gcc}"
-cp "$CONFIG" "$ROOT/src/u-boot/.config"; make -C "$ROOT/src/u-boot" olddefconfig; make -C "$ROOT/src/u-boot" -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"
-mkdir -p "$ROOT/dist/$BOARD"; cp "$ROOT/src/u-boot/u-boot.bin" "$ROOT/dist/$BOARD/u-boot.bin"
-FIP="${URSUS_FIP:-}"; if [ -z "$FIP" ] && [ "$BOARD" = xg040-md ]; then FIP="$ROOT/reference/md/ursusboot-test61-update.fip"; fi
-if [ -n "$FIP" ] && [ -f "$FIP" ]; then python3 "$ROOT/scripts/make-install-mtd0.py" --template "$TEMPLATE" --fip "$FIP" --output "$ROOT/dist/$BOARD/ursusboot-install-mtd0.bin"; fi
+CROSS="$(find "$STAGING_DIR" -type f \
+    \( -name 'aarch64-openwrt-linux-musl-gcc' -o -name 'aarch64-openwrt-linux-gcc' \) | head -1 || true)"
+[ -n "$CROSS" ] || { echo 'AArch64 compiler not found in OpenWrt SDK' >&2; exit 3; }
+export CROSS_COMPILE="${CROSS%gcc}"
+
+# The runtime role is applied at source level; ram-recovery rewrites the default
+# environment in the tree, so it needs a clean checkout.
+python3 "$ROOT/scripts/apply_runtime_role.py" "$ROOT/src/u-boot" --role "$ROLE" || {
+    echo "runtime role $ROLE could not be applied; restore the tree with:" >&2
+    echo "  git checkout -- src/u-boot/defenvs src/u-boot/include" >&2
+    exit 4
+}
+
+cp "$CONFIG" "$ROOT/src/u-boot/.config"
+make -C "$ROOT/src/u-boot" olddefconfig
+make -C "$ROOT/src/u-boot" -j"$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"
+
+mkdir -p "$ROOT/dist/$BOARD"
+cp "$ROOT/src/u-boot/u-boot.bin" "$ROOT/dist/$BOARD/u-boot.bin"
+
+# A FIP given with URSUS_FIP is used as-is. Otherwise the U-Boot just built is
+# packed into one, using the profile's reference FIP as the donor container:
+# only the NT_FW (BL33) payload is replaced, everything else is preserved.
+FIP="${URSUS_FIP:-}"
+if [ -z "$FIP" ]; then
+    DONOR="${URSUS_FIP_DONOR:-}"
+    if [ -z "$DONOR" ]; then
+        REF="$(profile_field reference_fip 2>/dev/null || true)"
+        [ -n "$REF" ] && DONOR="$ROOT/$REF"
+    fi
+    if [ -z "$DONOR" ] || [ ! -f "$DONOR" ]; then
+        echo "board $BOARD has no donor FIP; pass URSUS_FIP=<ready.fip> or URSUS_FIP_DONOR=<donor.fip>" >&2
+        exit 5
+    fi
+
+    LZTOOL="$ROOT/dist/$BOARD/lzma1ext_noeopm"
+    "${HOSTCC:-cc}" -O2 -w "$ROOT/src/u-boot/lzma1ext_noeopm.c" -llzma -o "$LZTOOL" || {
+        echo 'cannot build the host LZMA packer (liblzma headers missing?).' >&2
+        echo 'Install liblzma-dev, or pass a ready FIP with URSUS_FIP=<file>.' >&2
+        exit 5
+    }
+    "$LZTOOL" "$ROOT/src/u-boot/u-boot.bin" "$ROOT/dist/$BOARD/u-boot.lzma" "${URSUS_LZMA_DICT:-1048576}"
+
+    FIP="$ROOT/dist/$BOARD/ursusboot-update.fip"
+    python3 "$ROOT/src/u-boot/repack_persistent_fip.py" \
+        "$DONOR" "$ROOT/dist/$BOARD/u-boot.lzma" "$FIP"
+fi
+
+python3 "$ROOT/scripts/make-install-mtd0.py" \
+    --template "$TEMPLATE" --fip "$FIP" \
+    --output "$ROOT/dist/$BOARD/ursusboot-install-mtd0.bin"
+
+echo "URSUSBOOT_BUILD=OK board=$BOARD role=$ROLE out=dist/$BOARD"
