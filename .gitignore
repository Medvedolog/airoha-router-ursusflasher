__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
bundle/

# Рабочий каталог запуска: сессионные логи, персонализированный tcboot и снятые
# STOCKSET-бэкапы остаются локальными, сам каталог должен существовать в комплекте.
work/*
!work/.gitkeep
*.log

# Поставляемые payload — data/payloads/**/*.bin, fw/*.itb — и SHA256SUMS лежат
# в репозитории намеренно: релизный ZIP собирается из дерева, а CI сверяет
# каждый байт по SHA256SUMS. Отдельного правила, отсекающего их, тут нет — иначе
# каждый импорт пришлось бы протаскивать через `git add -f`, и однажды кто-нибудь
# этого не сделает.
