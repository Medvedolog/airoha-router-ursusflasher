        '          > **UrsusBoot alpha5-UBIUX1:** сборка и упаковка проверены, но отдельный\n          > аппаратный regression новой логики Recovery/UBI ещё не проведён.',
        '          > **UrsusBoot TEST61 / SAFETYREG1:** source/build/package QA пройден. TEST59/60\n          > отозваны для новых HW-прогонов; перед публикацией нужен полный hardware safety regression TEST61.')
    changed.add(rel)

    # ------------------------------------------------------- Documentation QA
    verify_docs = r'''#!/usr/bin/env python3
from __future__ import annotations
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VERSION = (ROOT / 'VERSION').read_text(encoding='utf-8').strip()
RELEASE = VERSION.split('-', 1)[0]
MANIFEST = json.loads((ROOT / 'config/MANIFEST.json').read_text(encoding='utf-8'))
BOOT = MANIFEST['ursusboot']['version']

assert RELEASE == '0.2.61', RELEASE
assert BOOT == '0.1.0-alpha5-UBIUX1-TEST61', BOOT

ru = (ROOT / 'README.md').read_text(encoding='utf-8')
en = (ROOT / 'docs/README_EN.md').read_text(encoding='utf-8')
ru_i = (ROOT / 'docs/INSTRUCTIONS_RU.md').read_text(encoding='utf-8')
en_i = (ROOT / 'docs/INSTRUCTIONS_EN.md').read_text(encoding='utf-8')
em = (ROOT / 'docs/EMERGENCY_URSUSBOOT_RU.md').read_text(encoding='utf-8')
rel_ru = (ROOT / 'ursusflasher/release/README.md').read_text(encoding='utf-8')
workflow = (ROOT / '.github/workflows/public-test-release.yml').read_text(encoding='utf-8')

for text in (ru, en):
    assert 'releases/latest' not in text

assert f'UrsusFlasher-{RELEASE}' in ru
assert 'TEST61' in ru and 'полного аппаратного прогона' in ru
assert 'Python 3.12+' in ru
assert 'пропустить полный `mtd0..mtd16` backup' in ru
assert 'один `[y/N]`' in ru

assert f'UrsusFlasher-{RELEASE}' in en
assert 'TEST61' in en and 'hardware safety regression' in en
assert 'Python **3.12+**' in en
assert 'MTD, UBI and UBIFS' not in en
assert 'UBIFS filesystem commands' in en
assert '75-second reconnect grace' in en

assert ru_i.startswith('# UrsusFlasher 0.2.61 / TEST61')
assert 'Python 3.12+' in ru_i
assert 'live-capture текущего `mtd0`' in ru_i
assert 'ONE-CLICK не запускает self-update' in ru_i

assert en_i.startswith('# UrsusFlasher 0.2.61 / TEST61')
assert 'Python 3.12+' in en_i
assert '75-second reconnect grace' in en_i
assert 'ONE-CLICK never performs an automatic self-update' in en_i
assert 'COMPLETE/FAILED state remains visible as history' in en_i

assert 'alpha3 lineage' in em
assert '0.1.0-alpha5-UBIUX1-TEST61' in em
assert 'раздельные manifest/hash поля' in em

assert 'Python 3.12+' in rel_ru
assert 'Python 3.12+' in workflow
assert 'hardware safety regression TEST61' in workflow

print('DOCS_IDENTITY_QA=PASS')
'''
    write_file(root, 'scripts/verify_docs.py', verify_docs)
    changed.add('scripts/verify_docs.py')

    # Keep the old entrypoint usable instead of leaving a stale standalone check.
    verify_readme = r'''#!/usr/bin/env python3
from __future__ import annotations
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
subprocess.run([sys.executable, str(ROOT / 'scripts/verify_docs.py')], cwd=ROOT, check=True)
print('README_RU_OPERATIONS_QA=PASS')
'''
    write_file(root, 'scripts/verify_readme_ru.py', verify_readme)
    changed.add('scripts/verify_readme_ru.py')

    rel = 'scripts/verify_repo.py'
    replace_once(root, rel,
        "env = os.environ.copy(); env['PYTHONDONTWRITEBYTECODE'] = '1'\nfor p in list(sorted((ROOT / 'ursusflasher/src').glob('*.py'))) + list(sorted((ROOT / 'ursusflasher/tools').glob('*.py'))):",
        "env = os.environ.copy(); env['PYTHONDONTWRITEBYTECODE'] = '1'\nsubprocess.run([sys.executable, str(ROOT / 'scripts/verify_docs.py')], cwd=ROOT, check=True, env=env)\nfor p in list(sorted((ROOT / 'ursusflasher/src').glob('*.py'))) + list(sorted((ROOT / 'ursusflasher/tools').glob('*.py'))):")
    changed.add(rel)

    # Regenerate the expected full release export checksums after documentation changes.
    sys.path.insert(0, str(root / 'scripts'))
    from repo_common import export_tree  # type: ignore
    with tempfile.TemporaryDirectory() as td:
        exported = export_tree(Path(td) / 'release')
        shutil.copy2(exported / 'SHA256SUMS', root / 'ursusflasher/release/SHA256SUMS.expected')
        shutil.copy2(exported / 'PAYLOAD_SHA256SUMS.txt', root / 'ursusflasher/release/PAYLOAD_SHA256SUMS.expected')
    changed.add('ursusflasher/release/SHA256SUMS.expected')
    changed.add('ursusflasher/release/PAYLOAD_SHA256SUMS.expected')

    # Update only touched/new paths in the repository checksum closure. Do not rescan .git.
    update_root_manifest(root, changed)

    env = dict(**__import__('os').environ)
    env['PYTHONDONTWRITEBYTECODE'] = '1'
    subprocess.run([sys.executable, str(root / 'scripts/verify_docs.py')], cwd=root, check=True, env=env)
    subprocess.run([sys.executable, '-m', 'py_compile', str(root / 'scripts/verify_docs.py'), str(root / 'scripts/verify_repo.py')], cwd=root, check=True, env=env)

    if args.full_qa:
        subprocess.run([sys.executable, str(root / 'scripts/verify_repo.py')], cwd=root, check=True, env=env)

    print('\nTEST61_DOCS_PATCH=PASS')
    print('Changed files:')
    for rel in sorted(changed):
        print(f'  {rel}')
    print('\nReview with: git diff --check && git diff')


if __name__ == '__main__':
    main()
