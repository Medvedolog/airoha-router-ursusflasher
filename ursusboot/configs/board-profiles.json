{
  "schema": 1,
  "runtime_roles": {
    "persistent": {
      "bootcmd": "ursusdispatch",
      "purpose": "normal persistent supervisor boot"
    },
    "ram-recovery": {
      "bootcmd": "ursusweb;true",
      "purpose": "RAM-only WebFailsafe recovery"
    }
  },
  "profiles": {
    "xg040-md": {
      "vendor": "Nokia",
      "model": "XG-040G-MD",
      "compatible": "nokia,xg-040g-md",
      "soc": "an7581",
      "fragments": [
        "ursusboot-common.cfg",
        "ursusboot-soc-an7581.cfg",
        "ursusboot-board-md.cfg",
        "ursusboot-storage-ubi-redundant.cfg"
      ],
      "board_policy_header": "xg040-md.h",
      "boot_policy": "md-stock-openwrt",
      "layout_policy": "md-ubi",
      "environment_policy": "ubi-redundant",
      "derivation": "native-md",
      "default_role": "persistent",
      "allowed_roles": ["persistent", "ram-recovery"]
    },
    "xg040-mf": {
      "vendor": "Nokia",
      "model": "XG-040G-MF",
      "compatible": "nokia,xg-040g-mf",
      "soc": "an7583",
      "fragments": [
        "ursusboot-common.cfg",
        "ursusboot-soc-an7583.cfg",
        "ursusboot-board-mf.cfg",
        "ursusboot-storage-ubi-redundant.cfg"
      ],
      "board_policy_header": "xg040-mf.h",
      "boot_policy": "mf-stock-openwrt",
      "layout_policy": "mf-ubi",
      "environment_policy": "ubi-redundant",
      "derivation": "native-mf",
      "default_role": "persistent",
      "allowed_roles": ["persistent", "ram-recovery"]
    },
    "xg140-md": {
      "vendor": "Bell/Nokia",
      "model": "XG-140G-MD",
      "compatible": "bell,xg-140g-md",
      "soc": "an7581",
      "fragments": [
        "ursusboot-common.cfg",
        "ursusboot-soc-an7581.cfg",
        "ursusboot-board-xg140.cfg",
        "ursusboot-storage-env-nowhere.cfg"
      ],
      "board_policy_header": "xg140-md.h",
      "boot_policy": "xg140-stock-ab-openwrt",
      "layout_policy": "xg140-native-stock",
      "environment_policy": "vendor-env-preserved",
      "derivation": "md-derived",
      "default_role": "persistent",
      "allowed_roles": ["persistent", "ram-recovery"]
    }
  }
}
