  UPD     include/config/uboot.release
  UPD     include/generated/version_autogenerated.h
  LDS     u-boot.lds
  CC      boot/fdt_support.o
  CC      cmd/version.o
  CC      common/version.o
  CC      cmd/ursusweb.o
  AR      common/built-in.a
  AR      boot/built-in.a
  AR      cmd/built-in.a
  LD      u-boot
  OBJCOPY u-boot.srec
  OBJCOPY u-boot-nodtb.bin
  RELOC   u-boot-nodtb.bin
  SYM     u-boot.sym
  CAT     u-boot-dtb.bin
  COPY    u-boot.bin
  OFCHK   .config
