+static bool ursus_netreset_used;
+
+static int do_ursusnetreset(struct cmd_tbl *cmdtp, int flag, int argc,
+			    char *const argv[])
+{
+	struct udevice *dev = eth_get_dev();
+	struct airoha_gdm_port *port;
+	struct airoha_qdma *qdma;
+	struct airoha_eth *eth;
+	struct regmap *scu_regmap;
+	u32 femem_sel = 0xffffffff;
+	int ret;
+
+	if (!dev || !dev->driver || strcmp(dev->driver->name, "airoha-eth-port")) {
+		printf("URSUS_NETRESET_FAIL reason=NO_ACTIVE_AIROHA_ETH\n");
+		return CMD_RET_FAILURE;
+	}
+
+	if (ursus_netreset_used) {
+		printf("URSUS_NETRESET_FAIL reason=ONE_SHOT_ALREADY_USED\n");
+		return CMD_RET_FAILURE;
+	}
+	ursus_netreset_used = true;
+
+	port = dev_get_priv(dev);
+	qdma = port->qdma;
+	eth = qdma->eth;
+
+	printf("URSUS_NETRESET_BEGIN build=TRANSITION2-NETRESET1 dev=%s\n",
+	       dev->name);
+	printf("URSUS_NETRESET_STAGE=STOP_CURRENT_DMA\n");
+	airoha_eth_stop(dev);
+
+	scu_regmap = airoha_get_scu_regmap();
+	if (IS_ERR(scu_regmap)) {
+		ret = PTR_ERR(scu_regmap);
+		printf("URSUS_NETRESET_FAIL stage=SCU_GET ret=%d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	ret = regmap_write(scu_regmap, SCU_SHARE_FEMEM_SEL, 0x0);
+	printf("URSUS_NETRESET_STAGE=FEMEM_SEL_WRITE ret=%d\n", ret);
+	if (ret)
+		return CMD_RET_FAILURE;
+	ret = regmap_read(scu_regmap, SCU_SHARE_FEMEM_SEL, &femem_sel);
+	printf("URSUS_NETRESET_STAGE=FEMEM_SEL_READ ret=%d value=0x%08x\n",
+	       ret, femem_sel);
+	if (ret || femem_sel != 0)
+		return CMD_RET_FAILURE;
+
+	printf("URSUS_NETRESET_STAGE=HARD_RESET_REINIT\n");
+	ret = airoha_hw_init(dev->parent, eth);
+	if (ret) {
+		printf("URSUS_NETRESET_FAIL stage=HW_INIT ret=%d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	ret = airoha_switch_init(dev->parent, eth);
+	if (ret) {
+		printf("URSUS_NETRESET_FAIL stage=SWITCH_INIT ret=%d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	ret = airoha_fe_init(port);
+	if (ret) {
+		printf("URSUS_NETRESET_FAIL stage=GDM_INIT ret=%d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	ret = arht_eth_write_hwaddr(dev);
+	if (ret) {
+		printf("URSUS_NETRESET_FAIL stage=HWADDR ret=%d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	ret = airoha_eth_init(dev);
+	if (ret) {
+		printf("URSUS_NETRESET_FAIL stage=ETH_START ret=%d\n", ret);
+		return CMD_RET_FAILURE;
+	}
+
+	printf("URSUS_NETRESET_DONE result=PASS next=RUN_URSUSWEB\n");
+	return CMD_RET_SUCCESS;
+}
+
+U_BOOT_CMD(
+	ursusnetreset, 1, 0, do_ursusnetreset,
+	"one-shot Airoha FE/PDMA/QDMA cleanup and re-init for TRANSITION2 NET debug",
+	""
+);
+
