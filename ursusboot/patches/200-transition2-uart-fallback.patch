--- a/cmd/ursusdispatch.c
+++ b/cmd/ursusdispatch.c
@@ -87,3 +87,17 @@ static int ursus_enter_webfailsafe(const char *reason, unsigned long hold_ms)
 
+    printf("URSUS_WEB_COMMAND_BEGIN time_ms=%lu\n", get_timer(0));
     ret = run_command("ursusweb", 0);
-    printf("URSUS_WEB_RETURNED ret=%d\nURSUS_RECOVERY_STILL_LATCHED=1\n", ret);
+    printf("URSUS_WEB_COMMAND_RETURN ret=%d time_ms=%lu\n", ret, get_timer(0));
+    printf("URSUS_WEB_RETURNED ret=%d\nURSUS_RECOVERY_STILL_LATCHED=1\n", ret);
