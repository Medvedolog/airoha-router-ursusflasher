--- /dev/null
+++ b/dts/upstream/src/arm64/airoha/an7581-bell-xg-140g-md.dts
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include "en7581.dtsi"
+
+/ {
+	model = "Bell XG-140G-MD";
+	compatible = "bell,xg-140g-md",
+		     "airoha,an7581",
+		     "airoha,en7581";
+
+	chosen {
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = "serial0:115200n8";
+		/* tcboot has already trained the production 512 MiB DDR4. */
+		linux,usable-memory-range = <0x0 0x80200000 0x0 0x1fe00000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x20000000>;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		button-0 {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-0 {
+			label = "blue:power";
+			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
+		};
+
+		led-1 {
+			label = "blue:pon";
+			gpios = <&en7581_pinctrl 18 GPIO_ACTIVE_LOW>;
+		};
+
+		led-2 {
+			label = "red:los";
+			gpios = <&en7581_pinctrl 19 GPIO_ACTIVE_LOW>;
+		};
+
+		led-3 {
+			label = "blue:internet";
+			gpios = <&en7581_pinctrl 20 GPIO_ACTIVE_LOW>;
+		};
+
+		led-4 {
+			label = "blue:fxs";
+			gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
+		};
+
+		led-5 {
+			label = "blue:usb2";
+			gpios = <&en7581_pinctrl 34 GPIO_ACTIVE_LOW>;
+		};
+
+		led-6 {
+			label = "blue:usb1";
+			gpios = <&en7581_pinctrl 35 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&snfi {
+	status = "okay";
+};
+
+&spi_nand {
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "bootloader";
+			reg = <0x00000000 0x00080000>;
+		};
+
+		partition@80000 {
+			label = "romfile";
+			reg = <0x00080000 0x00040000>;
+		};
+
+		partition@c0000 {
+			label = "nsb_master";
+			reg = <0x000c0000 0x02880000>;
+		};
+
+		partition@2940000 {
+			label = "nsb_slave";
+			reg = <0x02940000 0x02880000>;
+		};
+
+		partition@51c0000 {
+			label = "bosa";
+			reg = <0x051c0000 0x00040000>;
+		};
+
+		partition@5200000 {
+			label = "ri";
+			reg = <0x05200000 0x00040000>;
+		};
+
+		partition@5240000 {
+			label = "flag";
+			reg = <0x05240000 0x00040000>;
+		};
+
+		partition@5280000 {
+			label = "flagback";
+			reg = <0x05280000 0x00040000>;
+		};
+
+		partition@52c0000 {
+			label = "config";
+			reg = <0x052c0000 0x00a00000>;
+		};
+
+		partition@5cc0000 {
+			label = "data";
+			reg = <0x05cc0000 0x080e0000>;
+		};
+
+		partition@dda0000 {
+			label = "oopsfs";
+			reg = <0x0dda0000 0x00400000>;
+		};
+
+		partition@e1a0000 {
+			label = "log";
+			reg = <0x0e1a0000 0x00a00000>;
+		};
+	};
+};
+
+&i2c0 {
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
--- /dev/null
+++ b/arch/arm/dts/an7581-bell-xg-140g-md-u-boot.dtsi
@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+
+#include "an7581-u-boot.dtsi"
+
+/*
+ * Use the same proven AN7581 GDM1 recovery path as XG-040G-MD first.
+ * The 2.5G EN8811H/GDM4 path can be enabled after RAM1 hardware validation.
+ */
+&gdm1 { status = "okay"; };
