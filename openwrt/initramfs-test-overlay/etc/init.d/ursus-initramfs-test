#!/bin/sh /etc/rc.common
START=98
USE_PROCD=0
start() {
    mkdir -p /tmp/ursus-install
    board="$(cat /tmp/sysinfo/board_name 2>/dev/null || echo unknown)"
    if ursusstockslot probe >/tmp/ursus-install/probe.log 2>&1; then rollback=true; else rollback=false; fi
    cat > /tmp/ursus-install/status.json <<JSON
{"state":"BOOTED","mode":"BOOT_ONLY_TEST","destructive_started":false,"rollback_allowed":${rollback},"board":"${board}","error":null}
JSON
    {
        echo "URSUS_INITRAMFS_TEST_READY board=${board} mode=BOOT_ONLY destructive=DISABLED"
        cat /tmp/ursus-install/probe.log
        echo "URSUS_INITRAMFS_TEST_SSH user=root blank_password=allowed"
    } > /tmp/ursus-install/install.log
    logger -t ursus-initramfs-test "URSUS_INITRAMFS_TEST_READY board=${board} destructive=DISABLED"
}
